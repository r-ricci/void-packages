# Template file for 'libspatialite'
pkgname=libspatialite
version=5.1.0
revision=1
build_style=gnu-configure
hostmakedepends="pkg-config geos-devel"
makedepends="sqlite-devel zlib-devel proj-devel freexl-devel
 geos-devel librttopo-devel libxml2-devel minizip-devel"
short_desc="SQLite extension for Spatial SQL capabilities"
maintainer="Michael Aldridge <maldridge@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="https://www.gaia-gis.it/fossil/libspatialite/index"
distfiles="https://www.gaia-gis.it/gaia-sins/libspatialite-sources/libspatialite-${version}.tar.gz"
checksum=43be2dd349daffe016dd1400c5d11285828c22fea35ca5109f21f3ed50605080

pre_check() {
	# musl doesn't know about _USE_GNU, it's used internally by glibc
	# _GNU_SOURCE should be used instead, with both libcs
	sed -i 's/_USE_GNU/_GNU_SOURCE/g' ./test/*.c

	# TODO: investigate, report upstream
	local _expected_failures="check_sql_stmt check_sql_stmt_tiny"
	_expected_failures+=" check_sql_stmt_legacy check_sql_stmt_extension"
	sed -i '/^TESTS = /aXFAIL_TESTS = '"${_expected_failures}" ./test/Makefile
}

# TODO: .so symlink should be in libspatialite, not -devel

libspatialite-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
